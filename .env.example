# ── Shared ──────────────────────────────────────────────────
PORT=8000
LOGLEVEL=INFO
OPENAI_API_KEY=

# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Solana / Memecoin ──────────────────────────────────────
SOLANA_PRIVATE_KEY=
SOLANA_WALLET_ADDRESS=
HELIUS_RPC_URL=

# ── Forex Data ─────────────────────────────────────────────
# Get a free key at https://twelvedata.com (800 calls/day free)
TWELVE_DATA_API_KEY=
# Or Alpha Vantage as fallback: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ── Forex Broker (OANDA) ──────────────────────────────────
# For live forex execution; leave blank for paper trading only
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_PRACTICE=true

# ── Auto-Trading ──────────────────────────────────────────
AUTO_TRADE=true
MEMECOIN_LIVE=false
FOREX_LIVE=false
MEMECOIN_INTERVAL_MINUTES=20
FOREX_INTERVAL_MINUTES=60
APPROVE_FIRST=false

# ── MT5 Bridge ────────────────────────────────────────────
MT5_SECRET=
FOREX_LOT_SIZE=0.01

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
