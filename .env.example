# ── Shared ──────────────────────────────────────────────────
PORT=8000
LOGLEVEL=INFO
OPENAI_API_KEY=

# ── TypeSafe Jev (replaces OpenAI when set) ─────────────────
# Get a key at https://typesafe.ai — typed judgments instead of text parsing
TYPESAFE_API_KEY=

# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Discord (optional) ─────────────────────────────────────
# Create a webhook in your Discord server: Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# ── WhatsApp (optional) ────────────────────────────────────
# Setup: developers.facebook.com > Create WhatsApp Business app
# Get your Phone Number ID and permanent access token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT=

# ── Solana / Memecoin ──────────────────────────────────────
SOLANA_PRIVATE_KEY=
SOLANA_WALLET_ADDRESS=
HELIUS_RPC_URL=

# ── Forex Data ─────────────────────────────────────────────
# Get a free key at https://twelvedata.com (800 calls/day free)
TWELVE_DATA_API_KEY=
# Or Alpha Vantage as fallback: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ── Forex Broker (OANDA) ──────────────────────────────────
# For live forex execution; leave blank for paper trading only
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_PRACTICE=true

# ── Auto-Trading (safe defaults) ──────────────────────────
CONTROL_API_SECRET=replace-with-a-long-random-secret
AUTO_TRADE=false
MEMECOIN_LIVE=false
FOREX_LIVE=false
MEMECOIN_INTERVAL_MINUTES=20
FOREX_INTERVAL_MINUTES=60
APPROVE_FIRST=true
# Daily drawdown limit: bot stops opening new trades if daily P&L drops below this %
DAILY_MAX_DRAWDOWN_PCT=3.0
# News event filter: pause forex entries this many minutes before/after high-impact releases
NEWS_WINDOW_MINUTES=30
# Equity curve: pause trading after N consecutive losses, resume after M wins
MAX_CONSECUTIVE_LOSSES=5
WINS_TO_RESUME=2
# A separate, explicit unlock is required before any request can run live.
LIVE_TRADING_UNLOCK=false
# Signal-only delivery: no order execution, one scan per day by default.
DAILY_SIGNALS=true
DAILY_SIGNAL_INTERVAL_MINUTES=1440
SIGNAL_TIMEFRAME=1h
SIGNAL_PAIRS=EUR/USD,GBP/USD,USD/JPY,AUD/USD
# ── MT5 Bridge ────────────────────────────────────────────
MT5_SECRET=
FOREX_LOT_SIZE=0.01

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_NAMESPACE=trading_bot

# ── CodeWords (auto-provided on platform) ──────────────────
CODEWORDS_API_KEY=
CODEWORDS_RUNTIME_URI=
