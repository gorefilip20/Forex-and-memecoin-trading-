# Copy to .env.hostinger. Never commit the filled file.
PORT=8000
REDIS_URL=redis://redis:6379
REDIS_NAMESPACE=trading_bot
DEPLOYMENT_MODE=paper
RUN_SCHEDULER=false
AUTO_TRADE=false
FOREX_LIVE=false
MEMECOIN_LIVE=false
LIVE_TRADING_UNLOCK=false
LIVE_RISK_ACK=false
MEMECOIN_LIVE_ACK=false
MAX_LIVE_SLIPPAGE_BPS=200
APPROVE_FIRST=true
OANDA_PRACTICE=true
DAILY_MAX_DRAWDOWN_PCT=1.0
MAX_CONSECUTIVE_LOSSES=3
WINS_TO_RESUME=2
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
CONTROL_API_SECRET=replace-with-a-long-random-secret
MT5_SECRET=replace-with-a-different-long-random-secret
# Add data/notification keys only through the VPS secret manager or protected env file.
